# ═══════════════════════════════════════════════════════════════════
# .env.example — CALLEFITS BY DANNI
# ═══════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
# 1. Copia este archivo como `.env.local` en la raíz del proyecto.
# 2. Completa cada variable con los valores reales de tu proyecto Supabase.
# 3. JAMÁS versiones .env.local ni ningún archivo con claves reales.
#    El archivo .env.example (sin valores) SÍ se versiona como referencia.
#
# Supabase Dashboard → Project Settings → API
# ═══════════════════════════════════════════════════════════════════

# URL pública del proyecto Supabase (seguro exponer al cliente).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anónima (anon key) — acceso restringido por RLS (seguro exponer al cliente).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clave de rol de servicio — EXCLUSIVA del servidor, máximos privilegios.
# NUNCA usar el prefijo NEXT_PUBLIC_ para esta variable.
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
